# Copy to backend/.env and replace placeholders with your own values.
# Never commit backend/.env or real credentials.

# PostgreSQL connection (the values below match the local docker-compose.yml)
DATABASE_URL=postgresql+psycopg://app_user:dev_password@localhost:5432/tradeIt

# Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI for local development with backend on port 8000:
# http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret

# Frontend URL to redirect to after successful Google login
FRONTEND_URL=http://localhost:5500

# Comma-separated allowed frontend origins for CORS (no trailing slashes)
# If omitted, CORS defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:5500,https://tradeit-x2uy.onrender.com

# Authentication session lifetime in days (also sets session cookie max-age)
SESSION_DURATION_DAYS=7

# Auth cookie settings; for cross-site HTTPS frontend/backend use true + none.
# For a local HTTP-only same-site setup, false + lax can be used.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# Cookie used by Starlette SessionMiddleware for the OAuth handshake.
# Use true on HTTPS deployments; false permits local HTTP development.
OAUTH_SESSION_COOKIE_SECURE=false
